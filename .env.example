PORT=3000
# In production, use an absolute persistent Hostinger path outside the Git checkout.
UPLOAD_ROOT=/absolute/persistent/path/for/uploads
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_hostinger_db_user
DB_PASSWORD=your_hostinger_db_password
DB_NAME=your_hostinger_db_name
SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@professionalpeajbp.in
ADMIN_PASSWORD=change_me_before_first_start
ADMIN_NAME=Site Administrator
# Use port 465 with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false (STARTTLS).
# The provider may require SMTP_FROM_EMAIL to match SMTP_USER.
# Public canonical origin used in transactional email links.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@professionalpeajbp.in
SMTP_PASS=replace_with_real_password_in_hostinger
SMTP_FROM_EMAIL=admin@professionalpeajbp.in
SMTP_FROM_NAME=Professional Engineers Association Jabalpur
SITE_URL=https://professionalpeajbp.in
OTP_EXPIRES_MINUTES=10
