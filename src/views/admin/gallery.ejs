<%- include("../partials/head") %><%- include("../partials/header") %><main class="min-h-screen bg-slate-50 px-4 pt-28"><section class="mx-auto max-w-7xl py-12"><div class="mb-8 flex items-center justify-between"><div><h1>Manage Gallery</h1><p class="text-slate-600">Upload event photographs to persistent storage.</p></div><a href="/admin/dashboard" class="font-semibold text-primary">Dashboard</a></div><%- include("../partials/flash") %><form action="/admin/gallery" method="post" enctype="multipart/form-data" class="mb-10 grid gap-4 rounded-3xl bg-white p-6 shadow-sm md:grid-cols-2"><input required name="title" placeholder="Title" class="rounded-xl border-slate-200"><input required type="file" name="image" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"><textarea name="caption" placeholder="Caption" class="rounded-xl border-slate-200 md:col-span-2"></textarea><input type="date" name="event_date" class="rounded-xl border-slate-200"><input type="number" min="0" name="display_order" value="0" class="rounded-xl border-slate-200"><label><input type="checkbox" name="is_active" checked> Visible</label><button class="rounded-xl bg-primary p-3 font-semibold text-white">Add image</button></form><div class="grid gap-6 lg:grid-cols-2"><%images.forEach(item=>{%><article class="rounded-3xl bg-white p-5 shadow-sm"><img src="<%= item.image_path %>" alt="" class="mb-4 aspect-video w-full rounded-2xl object-cover"><form action="/admin/gallery/<%= item.id %>/edit" method="post" enctype="multipart/form-data" class="grid gap-3"><input required name="title" value="<%= item.title %>" class="rounded-xl border-slate-200"><textarea name="caption" class="rounded-xl border-slate-200"><%= item.caption||'' %></textarea><input type="date" name="event_date" value="<%= item.event_date ? new Date(item.event_date).toISOString().slice(0,10):'' %>"><input type="number" min="0" name="display_order" value="<%= item.display_order %>"><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"><label><input type="checkbox" name="is_active" <%= item.is_active?'checked':'' %>> Visible</label><button class="rounded-xl bg-primary p-3 text-white">Save</button></form><form action="/admin/gallery/<%= item.id %>/delete" method="post" onsubmit="return confirm('Delete this gallery image permanently?')"><button class="mt-3 text-sm font-semibold text-red-700">Delete</button></form></article><%})%></div></section></main><%- include("../partials/scripts") %>
