<%- include("../partials/head") %><%- include("../partials/header") %>
<main class="min-h-screen bg-slate-50 px-4 pt-28">
  <section class="mx-auto max-w-7xl py-12">
    <div class="mb-8 flex items-center justify-between gap-4">
      <div>
        <h1>Manage Gallery</h1>
        <p class="text-slate-600">Upload event photographs to persistent storage.</p>
        <p class="mt-2 font-semibold text-slate-700">Gallery Images: <%= images.length %> / <%= galleryLimit %></p>
      </div>
      <a href="/admin/dashboard" class="font-semibold text-primary">Dashboard</a>
    </div>
    <%- include("../partials/flash") %>
    <% if (images.length >= galleryLimit) { %>
      <div class="mb-6 rounded-2xl border border-amber-300 bg-amber-50 p-4 font-semibold text-amber-900" role="alert">Gallery is full. Delete an existing image to upload a new one.</div>
    <% } %>
    <form action="/admin/gallery" method="post" enctype="multipart/form-data" class="mb-10 grid gap-4 rounded-3xl bg-white p-6 shadow-sm md:grid-cols-2">
      <label class="grid gap-2 text-sm font-semibold text-slate-700"><span>Title</span><input required name="title" class="rounded-xl border-slate-200 font-normal text-slate-900"></label>
      <label class="grid gap-2 text-sm font-semibold text-slate-700"><span>Gallery Image</span><input required type="file" name="image" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="font-normal" <%= images.length >= galleryLimit ? 'disabled' : '' %>></label>
      <label class="grid gap-2 text-sm font-semibold text-slate-700 md:col-span-2"><span>Caption</span><textarea name="caption" class="rounded-xl border-slate-200 font-normal text-slate-900"></textarea></label>
      <label class="grid gap-2 text-sm font-semibold text-slate-700"><span>Event Date</span><input type="date" name="event_date" class="rounded-xl border-slate-200 font-normal text-slate-900"></label>
      <label class="grid gap-2 text-sm font-semibold text-slate-700"><span>Display Order</span><input type="number" min="0" name="display_order" value="0" class="rounded-xl border-slate-200 font-normal text-slate-900"><small class="font-normal text-slate-500">Lower numbers appear first in the gallery.</small></label>
      <label class="flex items-center gap-2 text-sm font-semibold text-slate-700"><input type="checkbox" name="is_active" checked><span>Visible</span></label>
      <button class="rounded-xl bg-primary p-3 font-semibold text-white disabled:cursor-not-allowed disabled:opacity-50" <%= images.length >= galleryLimit ? 'disabled' : '' %>>Add image</button>
    </form>
    <div class="grid gap-6 lg:grid-cols-2">
      <% images.forEach(item => { %>
        <article class="rounded-3xl bg-white p-5 shadow-sm">
          <img src="<%= item.image_path %>" alt="<%= item.title %>" class="mb-4 aspect-video w-full rounded-2xl object-cover">
          <form action="/admin/gallery/<%= item.id %>/edit" method="post" enctype="multipart/form-data" class="grid gap-3 md:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold text-slate-700 md:col-span-2"><span>Title</span><input required name="title" value="<%= item.title %>" class="rounded-xl border-slate-200 font-normal text-slate-900"></label>
            <label class="grid gap-2 text-sm font-semibold text-slate-700 md:col-span-2"><span>Caption</span><textarea name="caption" class="rounded-xl border-slate-200 font-normal text-slate-900"><%= item.caption || '' %></textarea></label>
            <label class="grid gap-2 text-sm font-semibold text-slate-700"><span>Event Date</span><input type="date" name="event_date" value="<%= item.event_date ? new Date(item.event_date).toISOString().slice(0,10) : '' %>" class="rounded-xl border-slate-200 font-normal text-slate-900"></label>
            <label class="grid gap-2 text-sm font-semibold text-slate-700"><span>Display Order</span><input type="number" min="0" name="display_order" value="<%= item.display_order %>" class="rounded-xl border-slate-200 font-normal text-slate-900"><small class="font-normal text-slate-500">Lower numbers appear first in the gallery.</small></label>
            <label class="grid gap-2 text-sm font-semibold text-slate-700 md:col-span-2"><span>Replace Image (Optional)</span><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="font-normal"></label>
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-700"><input type="checkbox" name="is_active" <%= item.is_active ? 'checked' : '' %>><span>Visible</span></label>
            <button class="rounded-xl bg-primary p-3 text-white">Save</button>
          </form>
          <form action="/admin/gallery/<%= item.id %>/delete" method="post" onsubmit="return confirm('Delete this gallery image permanently?')"><button class="mt-3 text-sm font-semibold text-red-700">Delete</button></form>
        </article>
      <% }) %>
    </div>
  </section>
</main>
<%- include("../partials/scripts") %>
