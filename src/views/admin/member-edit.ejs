<%- include("../partials/head") %>
<%- include("../partials/header") %>

<main class="min-h-screen bg-slate-50 px-4 pt-28">
  <section class="mx-auto max-w-5xl py-16">
    <% const values = { ...member, ...((typeof formData !== "undefined" && formData) ? formData : (formState && formState.adminEditMember) || {}) }; %>
    <div class="mb-6"><a href="/admin" class="text-sm font-semibold text-primary">Back to Dashboard</a></div>
    <div class="rounded-4xl border border-slate-200 bg-white p-8 shadow-sm">
      <h1 class="mb-6 text-3xl font-bold text-slate-900">Edit Member</h1>
      <form action="/admin/members/<%= member.id %>/edit" method="post" enctype="multipart/form-data" class="grid grid-cols-1 gap-4 md:grid-cols-2" data-validate-popup>
        <div class="space-y-2"><label for="edit-full-name" class="block text-sm font-semibold text-slate-700">Full Name</label><input id="edit-full-name" name="full_name" value="<%= values.full_name || '' %>" required placeholder="Full name" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /></div>
        <div class="space-y-2"><label for="edit-email" class="block text-sm font-semibold text-slate-700">Email Address</label><input id="edit-email" name="email" value="<%= values.email || '' %>" required type="email" placeholder="Email" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /></div>
        <div class="space-y-2"><label for="edit-phone" class="block text-sm font-semibold text-slate-700">Mobile Number</label><input id="edit-phone" name="phone" value="<%= values.phone || '' %>" placeholder="Phone" inputmode="numeric" data-validation-label="mobile number" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /></div>
        <div class="space-y-2"><label for="edit-profession" class="block text-sm font-semibold text-slate-700">Profession</label><input id="edit-profession" name="profession" value="<%= values.profession || '' %>" placeholder="Profession" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /></div>
        <div class="space-y-2"><label for="edit-city" class="block text-sm font-semibold text-slate-700">City</label><input id="edit-city" name="city" value="<%= values.city || '' %>" placeholder="City" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /></div>
        <div class="space-y-2"><label for="edit-marital-status" class="block text-sm font-semibold text-slate-700">Marital Status</label><select id="edit-marital-status" name="marital_status" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900">
          <option value="" <%= !values.marital_status ? 'selected' : '' %>>Marital status</option>
          <option value="single" <%= values.marital_status === 'single' ? 'selected' : '' %>>Single</option>
          <option value="married" <%= values.marital_status === 'married' ? 'selected' : '' %>>Married</option>
          <option value="divorced" <%= values.marital_status === 'divorced' ? 'selected' : '' %>>Divorced</option>
          <option value="widowed" <%= values.marital_status === 'widowed' ? 'selected' : '' %>>Widowed</option>
          <option value="prefer_not_to_say" <%= values.marital_status === 'prefer_not_to_say' ? 'selected' : '' %>>Prefer not to say</option>
        </select></div>
        <div class="space-y-2"><label for="edit-blood-group" class="block text-sm font-semibold text-slate-700">Blood Group</label><select id="edit-blood-group" name="blood_group" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900">
          <% bloodGroupOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= (values.blood_group || '') === option ? 'selected' : '' %>><%= option || 'Blood group' %></option>
          <% }) %>
        </select></div>
        <div class="space-y-2" data-family-field><label for="edit-children-count" class="block text-sm font-semibold text-slate-700">Number of Children</label><input id="edit-children-count" name="children_count" type="number" min="0" step="1" value="<%= values.children_count || values.children_count === 0 ? values.children_count : '' %>" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" data-family-input /></div>
        <div class="md:col-span-2">
          <label for="member-photo" class="mb-2 block text-sm font-semibold text-slate-700">Member Photo</label>
          <% if (member.photo) { %>
            <img src="<%= member.photo %>" alt="<%= member.full_name %>" class="mb-3 h-20 w-20 rounded-2xl object-cover" />
          <% } %>
          <input id="member-photo" name="photo" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 file:mr-4 file:rounded-full file:border-0 file:bg-primary file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white" />
          <p class="mt-2 text-xs text-slate-500">Optional. Upload a new photo to replace the current one. JPG, PNG, or WEBP up to 2 MB.</p>
        </div>
        <div class="space-y-2"><label for="edit-role" class="block text-sm font-semibold text-slate-700">Role</label><select id="edit-role" name="role" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900"><% memberRoles.forEach((role) => { %><option <%= values.role === role ? 'selected' : '' %>><%= role %></option><% }) %></select></div>
        <div class="space-y-2"><label for="edit-membership-status" class="block text-sm font-semibold text-slate-700">Membership Status</label><select id="edit-membership-status" name="membership_status" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900"><option value="pending" <%= values.membership_status === 'pending' ? 'selected' : '' %>>Pending</option><option value="approved" <%= values.membership_status === 'approved' ? 'selected' : '' %>>Approved</option><option value="rejected" <%= values.membership_status === 'rejected' ? 'selected' : '' %>>Rejected</option></select></div>
        <div class="space-y-2"><span class="block text-sm font-semibold text-slate-700">Member ID</span><div class="rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm text-slate-500"><%= member.member_id || 'Member ID will be generated automatically on approval.' %></div></div>
        <div class="space-y-2"><label for="edit-leadership-title" class="block text-sm font-semibold text-slate-700">Leadership Title</label><input id="edit-leadership-title" name="leadership_title" value="<%= values.leadership_title || '' %>" placeholder="Leadership title" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /></div>
        <div class="space-y-2"><label for="edit-display-order" class="block text-sm font-semibold text-slate-700">Display Order</label><input id="edit-display-order" name="important_member_order" type="number" min="0" value="<%= values.important_member_order || 0 %>" placeholder="Important member order" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /><p class="text-xs text-slate-500">Lower numbers appear first within the same role.</p></div>
        <div class="space-y-2"><label for="edit-dob" class="block text-sm font-semibold text-slate-700">Date of Birth</label><input id="edit-dob" name="dob" type="date" value="<%= values.dob ? new Date(values.dob).toISOString().split('T')[0] : '' %>" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /></div>
        <div class="space-y-2" data-family-field><label for="edit-marriage-date" class="block text-sm font-semibold text-slate-700">Marriage Date</label><input id="edit-marriage-date" name="marriage_date" type="date" value="<%= values.marriage_date ? new Date(values.marriage_date).toISOString().split('T')[0] : '' %>" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" data-family-input /></div>
        <div class="space-y-2" data-family-field><label for="edit-spouse-name" class="block text-sm font-semibold text-slate-700">Spouse Name</label><input id="edit-spouse-name" name="spouse_name" value="<%= values.spouse_name || '' %>" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" data-family-input /></div>
        <div class="space-y-2"><label for="edit-password" class="block text-sm font-semibold text-slate-700">New Password (Optional)</label><input id="edit-password" name="password" type="password" placeholder="New password (optional)" class="w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900" /></div>
        <div class="space-y-2 md:col-span-2"><label for="edit-address" class="block text-sm font-semibold text-slate-700">Address</label><textarea id="edit-address" name="address" placeholder="Address" class="min-h-[100px] w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900"><%= values.address || '' %></textarea></div>
        <div class="space-y-2"><label for="edit-member-notes" class="block text-sm font-semibold text-slate-700">Member Notes</label><textarea id="edit-member-notes" name="notes" placeholder="Member notes" class="min-h-[100px] w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900"><%= values.notes || '' %></textarea></div>
        <div class="space-y-2"><label for="edit-admin-notes" class="block text-sm font-semibold text-slate-700">Admin Notes</label><textarea id="edit-admin-notes" name="admin_notes" placeholder="Admin notes" class="min-h-[100px] w-full rounded-xl border-slate-200 bg-slate-50 text-slate-900"><%= values.admin_notes || '' %></textarea></div>
        <div class="md:col-span-2 grid grid-cols-1 gap-3 md:grid-cols-3">
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="show_in_directory" <%= values.show_in_directory ? 'checked' : '' %> /> Show in directory</label>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="show_mobile_in_directory" <%= values.show_mobile_in_directory ? 'checked' : '' %> /> Show mobile</label>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="show_email_in_directory" <%= values.show_email_in_directory ? 'checked' : '' %> /> Show email</label>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="show_city_in_directory" <%= values.show_city_in_directory ? 'checked' : '' %> /> Show city</label>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="show_profession_in_directory" <%= values.show_profession_in_directory ? 'checked' : '' %> /> Show profession</label>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="show_photo_in_directory" <%= values.show_photo_in_directory ? 'checked' : '' %> /> Show photo</label>
        </div>
        <button type="submit" class="md:col-span-2 rounded-2xl bg-primary px-6 py-4 text-base font-semibold text-white">Save Changes</button>
      </form>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
<%- include("../partials/scripts") %>
<script>
  (() => {
    const maritalStatusInput = document.querySelector('select[name="marital_status"]');
    const familyFields = Array.from(document.querySelectorAll("[data-family-field]"));
    const familyInputs = Array.from(document.querySelectorAll("[data-family-input]"));

    if (!maritalStatusInput || !familyFields.length) {
      return;
    }

    function clearFields(fields) {
      fields.forEach((field) => {
        field.value = "";
      });
    }

    function updateFamilyFields() {
      const isMarried = maritalStatusInput.value === "married";

      familyFields.forEach((field) => field.classList.toggle("hidden", !isMarried));

      if (!isMarried) {
        clearFields(familyInputs);
      }
    }

    maritalStatusInput.addEventListener("change", updateFamilyFields);
    updateFamilyFields();
  })();
</script>
