<%- include("../partials/head") %><%- include("../partials/header") %><main class="login-page min-h-screen bg-slate-50"><%- include("../partials/page-hero", { heroTitle:"Forgot Password", heroSubtitle:"Request a secure password reset link.", heroAlt:"Association gathering" }) %><section class="mx-auto max-w-xl px-4 py-12"><div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm"><% if(typeof successMessage!=="undefined"){%><p class="rounded-2xl bg-emerald-50 p-4 text-emerald-800"><%= successMessage %></p><%}else{%><form method="post" action="/forgot-password" class="space-y-5"><label class="block text-sm font-semibold">Registered email</label><input class="w-full rounded-xl border-slate-200" required type="email" name="email"><button class="w-full rounded-2xl bg-primary px-6 py-4 font-semibold text-white">Send reset instructions</button></form><%}%><a class="mt-6 inline-block text-sm font-semibold text-primary" href="/auth/login">Back to login</a></div></section></main><%- include("../partials/footer") %><%- include("../partials/scripts") %>
