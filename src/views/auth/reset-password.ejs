<%- include("../partials/head") %><%- include("../partials/header") %><main class="login-page min-h-screen bg-slate-50"><%- include("../partials/page-hero", { heroTitle:"Reset Password", heroSubtitle:"Choose a new secure password.", heroAlt:"Association gathering" }) %><section class="mx-auto max-w-xl px-4 py-12"><div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm"><%if(invalid){%><p class="text-red-700">This reset link is invalid or has expired.</p><a href="/forgot-password" class="mt-5 inline-block font-semibold text-primary">Request a new link</a><%}else{%><%if(typeof errorMessage!=="undefined"){%><p class="mb-4 text-red-700"><%= errorMessage %></p><%}%><form method="post" action="/reset-password/<%= token %>" class="space-y-5"><input class="w-full rounded-xl border-slate-200" required minlength="8" type="password" name="password" placeholder="New password"><input class="w-full rounded-xl border-slate-200" required minlength="8" type="password" name="confirm_password" placeholder="Confirm new password"><button class="w-full rounded-2xl bg-primary px-6 py-4 font-semibold text-white">Reset password</button></form><%}%></div></section></main><%- include("../partials/footer") %><%- include("../partials/scripts") %>
