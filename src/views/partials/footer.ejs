<footer class="site-footer relative overflow-hidden border-t border-blue-950 bg-[#0B1F3A] pb-6 pt-10 text-slate-300">
  <div class="pointer-events-none absolute left-1/2 top-0 h-64 w-full max-w-3xl -translate-x-1/2 rounded-full bg-primary/10 blur-[120px]"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <a href="/" class="group mb-4 flex items-center gap-3">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-slate-800 bg-slate-900 p-1.5 transition group-hover:scale-105">
            <img src="<%= siteSettings.logo_path || '/assets/images/pea-mark.svg' %>" onerror="this.onerror=null;this.src='/assets/images/pea-mark.svg';" alt="<%= siteSettings.site_title %> logo" class="h-full w-full object-contain" />
          </span>
          <span class="max-w-xs text-lg font-bold leading-snug tracking-tight text-white"><%= siteSettings.site_title %></span>
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-slate-400">Connecting Jabalpur's engineers through professional exchange, leadership and community contribution.</p>
      </div>

      <div class="lg:col-span-2 lg:col-start-6">
        <h3 class="mb-4 text-base font-bold text-white">Useful Links</h3>
        <ul class="space-y-2.5 text-sm">
          <% site.primaryNav.forEach((link) => { %>
            <li><a href="<%= link.href %>" class="inline-flex items-center text-slate-400 transition hover:text-primary"><%= link.label %></a></li>
          <% }) %>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class="mb-4 text-base font-bold text-white">Contact</h3>
        <div class="space-y-3 break-words text-sm text-slate-400">
          <div><%= siteSettings.address %></div>
          <div><a href="tel:<%= siteSettings.contact_phone %>" class="hover:text-white"><%= siteSettings.contact_phone %></a></div>
          <div><a href="https://wa.me/<%= siteSettings.whatsapp_number %>" class="text-amber-300 hover:text-white">Chat on WhatsApp</a></div>
          <div><a href="mailto:<%= siteSettings.contact_email %>" class="hover:text-white"><%= siteSettings.contact_email %></a></div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-start justify-between gap-3 border-t border-slate-800/60 pt-5 text-xs text-slate-500 sm:flex-row sm:items-center">
      <p>&copy; <%= new Date().getFullYear() %> <%= siteSettings.footer_text %></p>
    </div>
  </div>
</footer>
