<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-slate-200/60 bg-white/90 backdrop-blur-xl" data-site-header>
  <% const mobileAccountDisplayName = currentUser && (currentUser.full_name || currentUser.name || currentUser.display_name || currentUser.email); %>
  <div class="header-inner mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="brand-link flex items-center gap-3">
      <span class="brand-mark flex shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white shadow-sm">
        <img src="<%= siteSettings.logo_path || '/assets/images/pea-mark.svg' %>" onerror="this.onerror=null;this.src='/assets/images/pea-mark.svg';" alt="<%= siteSettings.site_title %> logo" />
      </span>
      <div class="brand-copy min-w-0">
        <div class="brand-title font-bold tracking-tight text-slate-900"><%= siteSettings.site_title %></div>
        <div class="brand-tagline truncate font-medium text-slate-500"><%= siteSettings.site_tagline %></div>
      </div>
    </a>

    <button type="button" class="inline-flex rounded-xl border border-slate-200 bg-white p-2.5 text-slate-700 shadow-sm lg:hidden" data-mobile-menu-toggle aria-label="Toggle navigation" aria-controls="mobile-navigation" aria-expanded="false">
      <i data-lucide="menu" class="h-5 w-5"></i>
    </button>

    <%- include("./navbar") %>
  </div>

  <div id="mobile-navigation" class="hidden border-t border-slate-200 bg-white lg:hidden" data-mobile-menu>
    <div class="mx-auto max-w-7xl space-y-2 px-4 py-2.5 sm:px-6">
      <% if (currentUser) { %>
        <div class="mb-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Signed in as</div>
          <div class="mt-1 break-words text-sm font-bold text-slate-900"><%= mobileAccountDisplayName %></div>
          <div class="mt-0.5 text-xs font-semibold text-slate-500"><%= isAdmin ? 'Administrator' : 'Member' %></div>
        </div>
      <% } %>
      <% site.primaryNav.forEach((link) => { %>
        <% if (link.href === '/member-directory' && !currentUser) { return; } %>
        <a href="<%= link.href %>" class="block rounded-2xl px-4 py-3 text-sm font-semibold <%= page.path === link.href ? 'bg-primary/10 text-primary' : 'text-slate-700 hover:bg-slate-100' %>"><%= link.label %></a>
      <% }) %>
      <% if (!currentUser) { %>
        <a href="/auth/login" class="block rounded-2xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100">Login</a>
      <% } else { %>
        <a href="<%= isAdmin ? '/admin/dashboard' : '/member/dashboard' %>" class="block rounded-2xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100"><%= isAdmin ? 'Admin Dashboard' : 'Dashboard' %></a>
        <% if (!isAdmin) { %>
          <a href="/member/profile" class="block rounded-2xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100">My Profile</a>
        <% } %>
        <form action="/auth/logout" method="post">
          <button type="submit" class="block w-full rounded-2xl px-4 py-3 text-left text-sm font-semibold text-slate-700 hover:bg-slate-100">Logout</button>
        </form>
      <% } %>
      <a href="/register" class="block rounded-2xl bg-primary px-4 py-3 text-center text-sm font-semibold text-white">Join Now</a>
    </div>
  </div>
</header>

<style>
  .account-menu__dropdown {
    position: absolute;
    top: calc(100% + .625rem);
    right: 0;
    z-index: 80;
    width: min(15rem, calc(100vw - 2rem));
    overflow: hidden;
    border: 1px solid rgb(226 232 240);
    border-radius: .875rem;
    background: white;
    box-shadow: 0 18px 40px rgba(15, 23, 42, .16);
  }
  .account-menu__item {
    display: block;
    padding: .625rem .75rem;
    border-radius: .625rem;
    color: rgb(51 65 85);
    font-size: .875rem;
    font-weight: 600;
    line-height: 1.25rem;
  }
  .account-menu__item:hover, .account-menu__item:focus-visible { background: rgb(241 245 249); color: rgb(15 23 42); }
  .account-menu__chevron { transition: transform .2s ease; }
  [data-account-menu-toggle][aria-expanded="true"] .account-menu__chevron { transform: rotate(180deg); }
  @media (min-width: 1200px) and (max-width: 1365px) {
    .account-menu__trigger { max-width: 10rem; padding-left: .625rem; padding-right: .625rem; }
  }
</style>
