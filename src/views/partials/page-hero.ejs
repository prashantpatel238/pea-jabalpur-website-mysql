<section class="page-hero relative flex items-center overflow-hidden pt-20">
  <div class="absolute inset-0 z-0">
    <img src="/assets/images/home-hero.png" alt="<%= heroAlt %>" class="page-hero__image h-full w-full object-cover" />
    <div class="page-hero__overlay"></div>
  </div>
  <div class="page-hero__content relative z-10 mx-auto w-full max-w-7xl px-4 text-center sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-white"><%= heroTitle %></h1>
      <p class="mx-auto text-slate-200"><%= heroSubtitle %></p>
    </div>
  </div>
</section>
