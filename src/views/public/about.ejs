<%- include("../partials/head") %>
<%- include("../partials/header") %>

<main>
  <section class="page-hero page-hero--compact page-hero--about relative flex items-center overflow-hidden pt-20">
    <div class="absolute inset-0 z-0">
      <img src="/assets/images/about-hero1.jpg" alt="Professional engineers collaborating in a modern workplace" class="page-hero__image h-full w-full object-cover" />
      <div class="page-hero__overlay"></div>
      <div class="hero-gradient"></div>
    </div>
    <div class="page-hero__content relative z-10 mx-auto w-full max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h1 class="mb-6 text-white">About Professional Engineers Association Jabalpur</h1>
        <p class="text-lg leading-relaxed text-slate-300 md:text-xl">A professional association connecting engineers across disciplines through knowledge sharing, collaboration, and service to the Jabalpur community.</p>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:px-8">
      <article class="surface-card rounded-2xl border border-slate-200 bg-slate-50 p-8 lg:p-10">
        <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary"><i data-lucide="target" class="h-8 w-8"></i></div>
        <h2 class="mb-6 text-3xl font-bold text-slate-900">Our Mission</h2>
        <p class="text-lg leading-relaxed text-slate-600">To bring engineering professionals together for knowledge sharing, professional connection, and collaborative initiatives that support responsible engineering practice in our region.</p>
      </article>
      <article class="surface-card rounded-2xl border border-slate-200 bg-slate-50 p-8 lg:p-10">
        <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-50 text-amber-700"><i data-lucide="eye" class="h-8 w-8"></i></div>
        <h2 class="mb-6 text-3xl font-bold text-slate-900">Our Vision</h2>
        <p class="text-lg leading-relaxed text-slate-600">To sustain an inclusive professional community where engineers can learn from one another, build trusted relationships, and contribute their expertise to Jabalpur and the wider region.</p>
      </article>
    </div>
  </section>

  <section class="bg-[#0B1F3A] py-20 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="section-label text-blue-200">Our association</div>
        <h2 class="mb-6 text-white">A shared platform for Jabalpur's engineers</h2>
        <div class="space-y-5 text-lg leading-relaxed text-slate-300">
          <p>Professional Engineers Association Jabalpur brings professionals from different engineering disciplines together around a common commitment to learning, ethical practice, and constructive collaboration.</p>
          <p>Through professional exchange and community initiatives, the association supports stronger connections among engineers and encourages members to contribute their knowledge for regional progress.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-slate-900">Our Core Values</h2>
        <p class="mx-auto max-w-2xl text-lg text-slate-600">The principles that guide how our association works, collaborates, and serves the engineering community.</p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        <% values.forEach((value) => { %>
          <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
            <div class="h-48 overflow-hidden">
              <img src="<%= value.image %>" alt="<%= value.title %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-110" />
            </div>
            <div class="p-8">
              <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-50 text-primary"><i data-lucide="<%= value.icon %>" class="h-7 w-7"></i></div>
              <h3 class="mb-3 text-xl font-bold text-slate-900"><%= value.title %></h3>
              <p class="text-slate-600"><%= value.description %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-100 bg-white py-24">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h2 class="mb-6 text-slate-900">Join the PEA Jabalpur community</h2>
      <p class="mx-auto mb-10 max-w-2xl text-xl text-slate-600">Connect with engineering peers, exchange knowledge, and take part in association initiatives across Jabalpur.</p>
      <a href="/register" class="inline-flex h-14 items-center justify-center rounded-full bg-primary px-8 text-base font-semibold text-white shadow-primary-soft transition hover:-translate-y-1 hover:bg-blue-700">Become a Member</a>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
<%- include("../partials/scripts") %>
