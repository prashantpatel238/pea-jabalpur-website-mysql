<%- include("../partials/head") %><%- include("../partials/header") %><main class="min-h-screen bg-slate-50"><%- include("../partials/page-hero", { heroTitle:"Gallery", heroSubtitle:"Moments from association events, professional gatherings and community activities.", heroAlt:"Association event gallery" }) %><section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8"><div class="gallery-grid"><% images.forEach((item,index)=>{%><button class="gallery-card text-left" type="button" data-gallery-index="<%= index %>" data-src="<%= item.image_path %>" data-title="<%= item.title %>"><img src="<%= item.image_path %>" alt="<%= item.title %>" loading="lazy"><span><strong><%= item.title %></strong><%if(item.event_date){%><small><%= new Date(item.event_date).toLocaleDateString('en-IN') %></small><%}%><%if(item.caption){%><em><%= item.caption %></em><%}%></span></button><%})%></div></section><div class="gallery-lightbox" hidden role="dialog" aria-modal="true" aria-label="Gallery image"><button data-close aria-label="Close">×</button><button data-prev aria-label="Previous image">‹</button><figure><img alt=""><figcaption></figcaption></figure><button data-next aria-label="Next image">›</button></div></main><%- include("../partials/footer") %><%- include("../partials/scripts") %><script>(()=>{const cards=[...document.querySelectorAll('[data-gallery-index]')],box=document.querySelector('.gallery-lightbox');if(!box)return;let at=0,show=i=>{at=(i+cards.length)%cards.length;box.querySelector('img').src=cards[at].dataset.src;box.querySelector('img').alt=cards[at].dataset.title;box.querySelector('figcaption').textContent=cards[at].dataset.title;box.hidden=false;box.querySelector('[data-close]').focus()};cards.forEach((c,i)=>c.onclick=()=>show(i));box.querySelector('[data-close]').onclick=()=>box.hidden=true;box.querySelector('[data-prev]').onclick=()=>show(at-1);box.querySelector('[data-next]').onclick=()=>show(at+1);document.addEventListener('keydown',e=>{if(box.hidden)return;if(e.key==='Escape')box.hidden=true;if(e.key==='ArrowLeft')show(at-1);if(e.key==='ArrowRight')show(at+1)});})();</script>
